# ignore everything in WP...
wordpress/*
.vite
package-lock.json
.env

# ignore all /dist
*/dist/

# I JSON di disponibilita' sono GENERATI dal cron termegest_check_availability
# e vivono solo sul server: quelli buoni sono quelli li'. Non vanno tracciati,
# e soprattutto non vanno deployati - una copia locale stantia sovrascriverebbe
# la disponibilita' reale e il calendario mostrerebbe date sbagliate.
# NB: che non finiscano sul server non dipende da questo file ma dall'--exclude
# in .github/workflows/deploy.yml (rsync carica anche i file ignorati da git).
**/plugin-custom-skianet/assets/data/
woocommerce-google-analytics-pro/
woo-satispay/
woocommerce-gateway-stripe/
mollie-payments-for-woocommerce/

# ignore node dependency directories
*/node_modules/

# ignore log files and databases
*.log
*.sql
*.sqlite

# ignore some editor settings
.vscode/*
ftp-kr.json

# impostazioni locali di Claude Code (per-macchina, non condivise).
# NB: .claude/, CLAUDE.md e .github/ restano TRACCIATI di proposito - sono
# documentazione del progetto. Che non finiscano sul server non dipende da
# questo file ma dagli --exclude in .github/workflows/deploy.yml.
.claude/settings.local.json
.claude/*.local.json

# ignore 💩 files
.DS_Store
.DS_store
.htaccess
license.txt
readme.html
